# ---------------------------------------------------------------------------
# Stock Predictor — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# See personal.md for where to obtain each value.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# "development" enables verbose errors and auto-reload. Use "production" when deployed.
APP_ENV=development

# Port the FastAPI backend listens on.
API_PORT=8001

# Comma-separated list of origins allowed to call the API from a browser.
# NEVER use "*" in production — that lets any website call this API as your user.
# 5173 is `npm run dev`; 4173 is `npm run preview`.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# --- Frontend ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Anything here is PUBLIC — never put a secret in a VITE_ variable.

VITE_API_BASE_URL=http://127.0.0.1:8001


# --- Market data providers --------------------------------------------------
# The app runs with NO keys at all: price history, charts, indicators, risk
# statistics, backtesting and simulation all work from yfinance, which needs no
# account. yfinance is unofficial and not licensed for redistribution, so it is
# fine locally but must be replaced before any public deployment.
#
# The keys below unlock market-wide features. Both are free and need no card.
# A feature whose key is missing reports itself unavailable through
# /api/v1/market/capabilities rather than showing placeholder data.
#
# Every variable listed in this file is read by the application. Nothing here
# configures a feature that does not exist yet.

# Enables news and ticker search. Free tier: 60 calls/min.
# https://finnhub.io/register
FINNHUB_API_KEY=

# Enables movers, sector performance, and company profiles.
# Free tier: 250 calls/day. The stock screener is NOT on the free tier — it
# returns HTTP 402, which is why that feature reports itself unavailable
# rather than showing invented rows.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=


# --- Caching ----------------------------------------------------------------

# How long (seconds) to cache quote and price-history responses.
CACHE_TTL_SECONDS=60

# Company names change far less often than prices, and `Ticker.info` is the
# most expensive upstream call, so profiles get their own much longer TTL.
PROFILE_CACHE_TTL_SECONDS=86400

# Market-wide data (movers, sectors) and news change slowly. These defaults keep
# usage far inside the free tiers: FMP allows 250 calls/day, Finnhub 60/minute.
MARKET_CACHE_TTL_SECONDS=300
NEWS_CACHE_TTL_SECONDS=900

# Seconds to wait on a provider before giving up.
PROVIDER_TIMEOUT_SECONDS=10


# --- Rate limiting ----------------------------------------------------------
# Per-client request cap, enforced in-process over a 60-second window. Stops a
# single caller exhausting the shared upstream quota for everyone else.
RATE_LIMIT_PER_MINUTE=60
