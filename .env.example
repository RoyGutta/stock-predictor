# ---------------------------------------------------------------------------
# Stock Predictor — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# See personal.md for where to obtain each value.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# "development" enables verbose errors and auto-reload. Use "production" when deployed.
APP_ENV=development

# Port the FastAPI backend listens on.
API_PORT=8001

# Comma-separated list of origins allowed to call the API from a browser.
# NEVER use "*" in production — that lets any website call this API as your user.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Frontend ---------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Anything here is PUBLIC — never put a secret in a VITE_ variable.

VITE_API_BASE_URL=http://127.0.0.1:8001


# --- Market data providers --------------------------------------------------
# The app runs with NO keys at all: it defaults to yfinance, which needs no
# account. yfinance is rate-limited and unofficial, so it is fine for local
# development but not for a public deployment.
#
# Set any of the below to enable a proper provider. See personal.md.

# Free tier: 25 requests/day. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Free tier: 60 calls/min. https://finnhub.io/register
FINNHUB_API_KEY=

# Free tier: 250 calls/day. https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=


# --- AI explanations (optional) ---------------------------------------------
# Used to generate plain-English explanations of computed indicators.
# The app works without this — explanations simply fall back to deterministic,
# template-based text. This key is server-side only and is never sent to the browser.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# --- Caching (optional) -----------------------------------------------------
# Leave empty to use an in-process cache. Set a Redis URL for multi-worker
# or multi-instance deployments.
REDIS_URL=

# How long (seconds) to cache market data responses.
CACHE_TTL_SECONDS=60
